<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pink Fanta Music</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #ff1493, #ff4fb3, #ff8dcc);
      overflow: hidden;
    }

    .card {
      width: 350px;
      padding: 35px 25px;
      text-align: center;
      color: white;
      background: rgba(255, 255, 255, 0.18);
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: 30px;
      backdrop-filter: blur(15px);
      box-shadow: 0 20px 50px rgba(180, 0, 100, 0.35);
    }

    .music-icon {
      width: 120px;
      height: 120px;
      margin: 0 auto 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 55px;
      border-radius: 50%;
      background: linear-gradient(145deg, #ff007f, #ff69b4);
      box-shadow:
        0 0 25px rgba(255, 255, 255, 0.5),
        inset 0 0 20px rgba(255,255,255,.2);
    }

    h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    p {
      opacity: .9;
      margin-bottom: 25px;
    }

    button {
      border: none;
      padding: 15px 35px;
      border-radius: 50px;
      font-size: 18px;
      font-weight: bold;
      color: #ff1493;
      background: white;
      cursor: pointer;
      transition: .25s;
      box-shadow: 0 8px 20px rgba(0,0,0,.2);
    }

    button:hover {
      transform: scale(1.08);
      box-shadow: 0 10px 30px rgba(255,255,255,.5);
    }

    .hearts {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: -1;
    }

    .heart {
      position: absolute;
      color: rgba(255,255,255,.35);
      font-size: 25px;
      animation: float 6s linear infinite;
    }

    @keyframes float {
      from {
        transform: translateY(110vh) rotate(0deg);
      }
      to {
        transform: translateY(-10vh) rotate(360deg);
      }
    }

    #youtube {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }
  </style>
</head>

<body>

  <div class="hearts">
    <span class="heart" style="left:10%;animation-delay:0s;">♥</span>
    <span class="heart" style="left:30%;animation-delay:2s;">♥</span>
    <span class="heart" style="left:55%;animation-delay:4s;">♥</span>
    <span class="heart" style="left:80%;animation-delay:1s;">♥</span>
  </div>

  <div class="card">
    <div class="music-icon">🎵</div>

    <h1>Pink Fanta Music</h1>
    <p>Now Playing — Linger 💗</p>

    <button id="playBtn" onclick="toggleMusic()">
      ▶ Play Lagu
    </button>
  </div>

  <!-- YouTube Player -->
  <div id="youtube">
    <iframe
      id="player"
      width="1"
      height="1"
      src="https://www.youtube.com/embed/G6Kspj3OO0s?enablejsapi=1"
      title="Linger - The Cranberries"
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <script>
    let isPlaying = false;
    const player = document.getElementById("player");
    const button = document.getElementById("playBtn");

    function toggleMusic() {
      if (!isPlaying) {
        player.contentWindow.postMessage(
          '{"event":"command","func":"playVideo","args":""}',
          "*"
        );

        button.innerHTML = "⏸ Pause Lagu";
        isPlaying = true;
      } else {
        player.contentWindow.postMessage(
          '{"event":"command","func":"pauseVideo","args":""}',
          "*"
        );

        button.innerHTML = "▶ Play Lagu";
        isPlaying = false;
      }
    }
  </script>

</body>
</html>
